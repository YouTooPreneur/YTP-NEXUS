{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tracker",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8765", "--bind", "127.0.0.1"],
      "port": 8765
    },
    {
      "name": "nexus-api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@ytp/api", "dev"],
      "port": 3000
    },
    {
      "name": "nexus-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@ytp/web", "dev"],
      "port": 5310
    }
  ]
}
