{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python tools/history/export-session.py --background || python \"$CLAUDE_PROJECT_DIR/tools/history/export-session.py\" --background",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python tools/history/export-session.py --locked || python \"$CLAUDE_PROJECT_DIR/tools/history/export-session.py\" --locked",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
