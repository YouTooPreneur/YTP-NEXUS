{
  "name": "ytp-nexus",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "api:generate": "pnpm --filter @ytp/contracts openapi && pnpm --filter @ytp/web api",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "services:up": "docker compose -f infra/compose.dev.yaml --env-file infra/.env up -d --wait",
    "services:down": "docker compose -f infra/compose.dev.yaml --env-file infra/.env down",
    "verify": "node tools/verify/verify.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
